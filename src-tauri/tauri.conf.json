{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dae",
  "version": "0.3.0",
  "identifier": "com.melaine.dae",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run bindings:export && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "dae",
        "width": 800,
        "height": 600,
        "decorations": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dae"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/assets/fonts/LICENSE-Sarasa-Gothic.txt": "licenses/LICENSE-Sarasa-Gothic.txt",
      "../src/assets/fonts/NOTICE-Nerd-Fonts.txt": "licenses/NOTICE-Nerd-Fonts.txt"
    }
  }
}
