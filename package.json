{
  "name": "dae",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "lint": "vp lint src vite.config.ts",
    "lint:type-aware": "vp lint --type-aware src vite.config.ts",
    "lint:fix": "vp lint --fix src vite.config.ts",
    "lint:type-aware:fix": "vp lint --type-aware --fix src vite.config.ts",
    "preview": "vp preview",
    "tauri": "tauri",
    "tauri:dev:withidentity": "bun run bindings:export && bun run build && cargo build --manifest-path src-tauri/Cargo.toml && (if not exist dist mkdir dist) && copy /Y src-tauri\\target\\debug\\dae.exe dist\\ >nul && winapp run .\\dist",
    "pack:msix": "node scripts/sync-msix-version.mjs && bun tauri build --no-bundle && (if not exist dist mkdir dist) && copy /Y src-tauri\\target\\release\\dae.exe dist\\ >nul && winapp pack .\\dist --cert .\\devcert.pfx",
    "icons:icon": "bun scripts/render-icon.mjs && bun tauri icon src-tauri/icons/source/goose-master.png",
    "test:rust": "src-tauri\\target\\bin\\cargo-nextest.exe nextest run --manifest-path src-tauri/Cargo.toml",
    "test:rust:setup": "cargo binstall -y cargo-nextest --install-path src-tauri/target/bin",
    "bindings:export": "cargo run --manifest-path src-tauri/Cargo.toml --features export-bindings --bin export_bindings"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@solar-icons/react": "^2.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/highlight": "^1.0.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "jotai": "^3.0.1",
    "jotai-family": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-dev-invoke-api": "^0.3.1",
    "tauri-plugin-snap-layout": "1.0.9",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@solar-icons/cli": "^2.5.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
