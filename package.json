{
  "name": "dae",
  "version": "0.5.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Release tooling for dae. The application is Rust + QML; Node runs the packaging, signing, icon and PGO scripts and nothing else.",
  "scripts": {
    "perf:pgo:qt:instrument": "bun scripts/opt/pgo.mjs instrument --qt",
    "perf:pgo:qt:train": "bun scripts/opt/pgo.mjs train --qt",
    "perf:pgo:qt:merge": "bun scripts/opt/pgo.mjs merge --qt",
    "perf:pgo:qt:build": "bun scripts/opt/pgo.mjs build --qt",
    "perf:pgo:qt:build:bolt": "bun scripts/opt/pgo.mjs build --qt --bolt",
    "perf:pgo:qt:status": "bun scripts/opt/pgo.mjs status --qt",
    "perf:bolt:qt": "bun scripts/opt/bolt.mjs all --qt",
    "perf:post-link": "bun scripts/opt/post-link.mjs",
    "pack:msix": "pwsh -NoProfile -File scripts/pack-msix.ps1",
    "verify:msix": "pwsh -NoProfile -File scripts/msix-verify.ps1",
    "update:feed": "node scripts/qt-update-feed.mjs",
    "icons:icon": "bun scripts/render-icon.mjs",
    "test:rust": "cargo nextest run",
    "test:rust:setup": "cargo binstall -y cargo-nextest",
    "lint:qml": "qmllint qml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "sharp": "^0.35.5"
  }
}
