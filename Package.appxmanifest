<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 desktop desktop6 rescap">

  <Identity
    Name="dae"
    Publisher="CN=Mt342"
    Version="0.5.0.0" />

  <Properties>
    <DisplayName>dae</DisplayName>
    <PublisherDisplayName>Mt342</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="0.2.1.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="dae"
      Executable="$targetnametoken$.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="dae"
        Description="Aesthetic file manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png">
        <uap:DefaultTile Wide310x150Logo="Assets\WideTile.png" />
      </uap:VisualElements>
      <!-- The scheme is registered for the application, not for one executable
           path. An installed package is copied to a directory named after its
           version, so a per-user `HKCU\Software\Classes\dae` command would go
           stale on the first update; `dae-qt`'s `activation` module therefore
           skips its registry write when it detects package identity. -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="dae">
            <uap:DisplayName>dae link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- A launch path that survives an update. The package is unpacked into
             a directory named after its version, so anything that stores an
             absolute path — the per-user ProgID `default_manager` writes, a
             taskbar pin, a script — breaks on the next update. The alias is
             resolved by Windows through `%LOCALAPPDATA%\Microsoft\WindowsApps\
             dae.exe` to whichever version is installed, so `default_manager`
             registers that path instead of the versioned executable. -->
        <uap3:Extension Category="windows.appExecutionAlias"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="dae.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
